#include "winres.h"
#include "BuildInfo.h"

// What Windows and antivirus engines read as the program's identity (see launcher.rc).
VS_VERSION_INFO VERSIONINFO
FILEVERSION BUILD_MAJOR,BUILD_MINOR,BUILD_PATCH,BUILD_SINCE
PRODUCTVERSION BUILD_MAJOR,BUILD_MINOR,BUILD_PATCH,BUILD_SINCE
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "urSovngarde"
            VALUE "ProductName", "urSovngarde"
            VALUE "FileDescription", "urSovngarde server"
            VALUE "InternalName", "urSovngardeServer"
            VALUE "OriginalFilename", "urSovngardeServer.exe"
            VALUE "FileVersion", BUILD_FILEVERSION
            VALUE "ProductVersion",	BUILD_BRANCH "@" BUILD_COMMIT
            VALUE "LegalCopyright", "urSovngarde contributors and Tilted Phoques (Skyrim Together Reborn), GPL-3.0 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "resources/server.manifest"

102 ICON "resources/st_srv.ico"
