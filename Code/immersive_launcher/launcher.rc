#include "winres.h"
#include "BuildInfo.h"

// What Windows and antivirus engines read as the program's identity. Until 2026-10-09 it was the upstream's, at
// 0.0.0.0 and named launcher.exe, and engines that guess weigh an unsigned program with no believable identity as
// suspicious. The numbers and texts come from the root xmake.lua.
VS_VERSION_INFO VERSIONINFO
FILEVERSION BUILD_MAJOR,BUILD_MINOR,BUILD_PATCH,BUILD_SINCE
PRODUCTVERSION BUILD_MAJOR,BUILD_MINOR,BUILD_PATCH,BUILD_SINCE
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "urSovngarde"
#ifdef SKYRIMVR
            VALUE "ProductName", "urSovngarde"
            VALUE "FileDescription", "urSovngarde (Skyrim VR co-op)"
            VALUE "InternalName", "urSovngarde"
            VALUE "OriginalFilename", "urSovngarde.exe"
#else
            VALUE "ProductName", "Skyrim Together"
            VALUE "FileDescription", "Skyrim Together (Skyrim co-op)"
            VALUE "InternalName", "SkyrimTogether"
            VALUE "OriginalFilename", "SkyrimTogether.exe"
#endif
            VALUE "FileVersion", BUILD_FILEVERSION
            VALUE "ProductVersion",	BUILD_BRANCH "@" BUILD_COMMIT
            VALUE "LegalCopyright", "urSovngarde contributors and Tilted Phoques (Skyrim Together Reborn), GPL-3.0 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "resources/launcher.manifest"

102 ICON "resources/st.ico"
